{
  "manifest_version": 3,
  "name": "TextReadsFast for YouTube",
  "version": "0.1.0",
  "description": "Read YouTube subtitles one word at a time, at a fixed focal point, so you can follow along at 2x.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["*://*.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["reader.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js", "fonts/*"],
      "matches": ["*://www.youtube.com/*"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "TextReadsFast",
    "default_popup": "popup.html"
  }
}
